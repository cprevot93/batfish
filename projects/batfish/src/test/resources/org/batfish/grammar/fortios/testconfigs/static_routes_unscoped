config global
    config system global
        set hostname "static_routes_unscoped"
    end
    config system interface
        edit "npu0_vlink0"
            set vdom "root"
            set type physical
            set ip 192.0.2.1 255.255.255.0
        next
        edit "npu0_vlink1"
            set vdom "tenant"
            set type physical
            set ip 192.0.2.2 255.255.255.0
        next
    end
end

config vdom
    edit root
        config router static
            edit 20
                set dst 203.0.113.0 255.255.255.0
                set gateway 192.0.2.2
                set device "npu0_vlink0"
            next
        end
    next
    edit tenant
        config router static
            edit 21
                set dst 198.51.100.0 255.255.255.0
                set gateway 192.0.2.1
                set device "npu0_vlink1"
            next
        end
    next
end
